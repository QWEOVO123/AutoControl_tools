DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

AGENT_PORT=8000
AGENT_DATA_DIR=.agent-data
AGENT_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Auto budget uses the model window; set an optional input cap and recent-history target:
# AGENT_CONTEXT_TOKEN_BUDGET=120000
# AGENT_CONTEXT_KEEP_TOKENS=16000
# Nginx HTTPS deployment:
# AGENT_ALLOWED_HOSTS=["agent.example.com"]
# AGENT_PUBLIC_ORIGIN=https://agent.example.com
# AGENT_COOKIE_SECURE=true
